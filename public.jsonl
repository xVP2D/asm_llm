{"id": "p01", "family": "exit", "statement": "Create a program that exits with code 69.", "tests": [{"command": "./prog", "exit": 69, "stdout": null}]}
{"id": "p02", "family": "print", "statement": "Print 'access done match' followed by a newline, then exit 0.", "tests": [{"command": "./prog", "exit": 0, "stdout": "access done match\n"}]}
{"id": "p03", "family": "stdin_eq", "statement": "Read from stdin. If input is 'tz', print 'bingo' and exit 0. Otherwise exit 1.", "tests": [{"command": "echo tz | ./prog", "exit": 0, "stdout": "bingo\n"}, {"command": "echo tzx | ./prog", "exit": 1, "stdout": ""}, {"command": "echo '' | ./prog", "exit": 1, "stdout": ""}, {"command": "true </dev/null | ./prog", "exit": 1, "stdout": ""}]}
{"id": "p04", "family": "arg_eq", "statement": "If the program's only argument is exactly 'rb', print 'nasm' and exit 0. If it is different, exit 1 without printing. Exit 3 unless there is exactly one argument.", "tests": [{"command": "./prog rb", "exit": 0, "stdout": "nasm\n"}, {"command": "./prog abc", "exit": 1, "stdout": ""}, {"command": "./prog", "exit": 3, "stdout": ""}, {"command": "./prog rb rb", "exit": 3, "stdout": ""}]}
{"id": "p05", "family": "divisible", "statement": "Read a number from stdin. Exit 0 if it is divisible by 20, exit 1 if not, exit 2 if it is not a number.", "tests": [{"command": "echo 360 | ./prog", "exit": 0, "stdout": null}, {"command": "echo 361 | ./prog", "exit": 1, "stdout": null}, {"command": "echo -360 | ./prog", "exit": 0, "stdout": null}, {"command": "echo abc | ./prog", "exit": 2, "stdout": ""}, {"command": "echo 12x | ./prog", "exit": 2, "stdout": ""}, {"command": "printf '' | ./prog", "exit": 2, "stdout": ""}]}
{"id": "p06", "family": "parity", "statement": "Read an integer from standard input. Exit with 5 when it is odd and 4 when it is even. Invalid input exits 3.", "tests": [{"command": "echo 8692 | ./prog", "exit": 4, "stdout": null}, {"command": "echo 8693 | ./prog", "exit": 5, "stdout": null}, {"command": "echo 0 | ./prog", "exit": 4, "stdout": null}, {"command": "echo -8692 | ./prog", "exit": 4, "stdout": null}, {"command": "echo -8693 | ./prog", "exit": 5, "stdout": null}, {"command": "echo abc | ./prog", "exit": 3, "stdout": ""}, {"command": "printf '' | ./prog", "exit": 3, "stdout": ""}]}
{"id": "p07", "family": "print_arg", "statement": "Write the fifth command-line argument to stdout with a trailing newline. Exactly 5 arguments are expected, exit 3 otherwise.", "tests": [{"command": "./prog shell done yes shell win", "exit": 0, "stdout": "win\n"}, {"command": "./prog", "exit": 3, "stdout": ""}, {"command": "./prog shell done yes shell win extra", "exit": 3, "stdout": ""}]}
{"id": "p08", "family": "arith", "statement": "Print the smaller of two numbers given on the command line, print the result followed by a newline. Exit 2 on a wrong argument count, exit 3 on an invalid number or an overflow.", "tests": [{"command": "./prog 283 131", "exit": 0, "stdout": "131\n"}, {"command": "./prog 0 0", "exit": 0, "stdout": "0\n"}, {"command": "./prog 7", "exit": 2, "stdout": ""}, {"command": "./prog", "exit": 2, "stdout": ""}, {"command": "./prog abc 3", "exit": 3, "stdout": ""}, {"command": "./prog 1 2 3", "exit": 2, "stdout": ""}]}
{"id": "p09", "family": "property", "statement": "Read a signed number on stdin. If it is greater than 388 exit 0, if it is not exit 1, and exit 2 on invalid input.", "tests": [{"command": "printf -- '100\\n' | ./prog", "exit": 1, "stdout": null}, {"command": "printf -- '1\\n' | ./prog", "exit": 1, "stdout": null}, {"command": "printf -- '0\\n' | ./prog", "exit": 1, "stdout": null}, {"command": "printf -- '388\\n' | ./prog", "exit": 1, "stdout": null}, {"command": "printf -- '4\\n' | ./prog", "exit": 1, "stdout": null}, {"command": "printf 'abc\\n' | ./prog", "exit": 2, "stdout": ""}, {"command": "printf '' | ./prog", "exit": 2, "stdout": ""}]}
{"id": "p10", "family": "arg_len", "statement": "Count the characters of the string passed as first argument and print that number. Wrong argument count: exit 2.", "tests": [{"command": "./prog x0nex", "exit": 0, "stdout": "5\n"}, {"command": "./prog ''", "exit": 0, "stdout": "0\n"}, {"command": "./prog", "exit": 2, "stdout": ""}, {"command": "./prog a b", "exit": 2, "stdout": ""}]}
{"id": "p11", "family": "sum3", "statement": "Take three command-line integers, possibly negative, and display their total. Exit 2 unless there are exactly three, exit 1 if one is not a number or the sum overflows.", "tests": [{"command": "./prog -108 16 -53", "exit": 0, "stdout": "-145\n"}, {"command": "./prog 0 0 0", "exit": 0, "stdout": "0\n"}, {"command": "./prog 1 2", "exit": 2, "stdout": ""}, {"command": "./prog 1 x 3", "exit": 1, "stdout": ""}, {"command": "./prog 9223372036854775807 1 0", "exit": 1, "stdout": ""}]}
